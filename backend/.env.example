# Copy to .env for local development. Values here match docker-compose.yml.

# --- Database -------------------------------------------------------------
# Host-side (running the API with `npm run start:dev` against compose Postgres):
DATABASE_URL="postgresql://stockroom:stockroom@localhost:5432/stockroom"
# Inside compose the host is the service name instead:
# DATABASE_URL="postgresql://stockroom:stockroom@db:5432/stockroom"

# --- Auth -----------------------------------------------------------------
# Replace before any non-demo deployment.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="24h"

# --- API ------------------------------------------------------------------
PORT=3000
# Comma-separated allowlist, or "*" to mirror any origin.
FRONTEND_URL="http://localhost:4200"

# --- Seed -----------------------------------------------------------------
# Password given to both demo accounts. Rotate for anything but a demo.
SEED_PASSWORD="Demo1234!"

# --- Optional backing services -------------------------------------------
# Unset is fine: the app degrades the feature instead of failing to boot, and a
# manager can supply these at runtime via /admin/settings.
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=
